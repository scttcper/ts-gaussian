{
  "name": "ts-gaussian",
  "version": "4.0.3",
  "description": "A TypeScript model of a Gaussian distribution",
  "keywords": [
    "distribution",
    "gaussian",
    "normal",
    "typescript"
  ],
  "homepage": "https://ts-gaussian.vercel.app",
  "license": "MIT",
  "author": "Scott Cooper <scttcper@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scttcper/ts-gaussian.git"
  },
  "files": [
    "dist/src"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/src/index.d.ts",
  "exports": "./dist/src/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "oxlint . && oxfmt . --check",
    "lint:fix": "oxlint . --fix && oxfmt . --write",
    "prepare": "npm run build",
    "build": "tsc",
    "build:docs": "typedoc",
    "bench": "vitest bench ./test/bench.bench.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@ctrl/oxlint-config": "1.4.0",
    "@sindresorhus/tsconfig": "8.1.0",
    "@types/node": "25.2.3",
    "oxfmt": "0.33.0",
    "oxlint": "1.48.0",
    "typedoc": "0.28.17",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "release": {
    "branches": [
      "master"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
